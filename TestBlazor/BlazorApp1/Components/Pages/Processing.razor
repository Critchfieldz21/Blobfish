@page "/processing"
@using BackendLibrary
@rendermode InteractiveServer
@inject ShopTicketService sTService
@inject NavigationManager Navigation

<PageTitle>PDF Info</PageTitle>

<section class="mt-3">
    <div>
        <button class="homeButt" @onclick="GoHome">Back to Home</button>
    </div>
</section>

<section>
    <div class="titleName">
        <h1>PDF Info: @setName()</h1>
    </div>
</section>
<section>
    <div class="pdfcontainer">
        <div class="pdfVisBox">
        </div>
        <div class="pdfinfo">
            <p>@((MarkupString)sTService.CurrentTicket?.ToString().Replace("\n", "<br />"))</p>
        </div>
        <div class="clear"></div>
    </div>
</section>
@code {

    private String? setName()
    {
        return sTService.CurrentTicket?.FileName;
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}