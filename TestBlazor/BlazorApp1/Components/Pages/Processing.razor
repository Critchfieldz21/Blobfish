@page "/processing"
@using BackendLibrary
@using BlazorBootstrap
@using Microsoft.AspNetCore.WebUtilities
@using System.Linq
@rendermode InteractiveServer
@inject ShopTicketService sTService
@inject NavigationManager Navigation
<link href="_content/Blazor.Bootstrap/blazor.bootstrap.css" rel="stylesheet" />
<script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script>

<PageTitle>PDF Info</PageTitle>

<section class="topbar">
    <button class="homeButt" type="button" @onclick="GoHome">Back to Home</button>
    <button class="historyButt" type="button" @onclick="GoHistory">History</button>
    <button class="navbtn" type="button" @onclick="GoLeft">←</button>
    <button class="navbtn" type="button" @onclick="GoRight">→</button>
</section>

<section>
    <div class="titleName">
        <h1>PDF Info: <span class="pdf-name" title="@setName()">@setName()</span></h1>
    </div>
</section>

<section class="pdf-processing-container">
    <!-- PDF Viewer -->
    <div class="pdfVisBox">
        @if (!string.IsNullOrEmpty(base64Url))
        {
            <PdfViewer @key="base64Url" Class="pdfViewer" Url="@base64Url" OnDocumentLoaded="OnDocumentLoaded"
                OnPageChanged="OnPageChanged" />
        }
        else
        {
            <p><em>No PDF data available to display.</em></p>
        }
    </div>
    <!-- PDF Info -->
    <div class="pdfinfo">
        <table class="info-table">
            <tr><th>File Name</th><td>@(ticket?.FileName ?? "(no file)")</td></tr>
            <tr><th>Pages</th><td>@(ticket?.NumberOfPages.ToString() ?? "")</td></tr>
            <tr><th>Processed</th><td>@(ticket != null ? ticket.dateTimeExtracted.ToLocalTime().ToString("g") : "")</td></tr>
            <tr><th>Project #</th><td>@(ticket?.ProjectNumber ?? "")</td></tr>
            <tr><th>Project</th><td>@(ticket?.ProjectName ?? "")</td></tr>
            <tr><th>File Name Piece Mark</th><td>@(ticket?.FileNamePieceMark ?? "")</td></tr>
            <tr><th>File Content Piece Mark</th><td>@(ticket?.FileContentPieceMark ?? "")</td></tr>
            <tr><th>Control Numbers</th><td>@(ticket?.ControlNumbers != null ? string.Join(", ", ticket.ControlNumbers) : "null")</td></tr>
            <tr><th>Pieces Req'd</th><td>@(ticket?.PiecesRequired.ToString() ?? "")</td></tr>
            <tr><th>Weight</th><td>@(ticket != null ? ticket.Weight + " lb" : "")</td></tr>
            <tr><th>Design #</th><td>@(ticket?.DesignNumber ?? "")</td></tr>
            <tr><th>Page Names</th><td>@(ticket?.PageNames != null ? string.Join(", ", ticket.PageNames) : "")</td></tr>
            <tr><th>Rectangle Page</th><td>@((ticket != null ? ticket.RectanglePage : ""))</td></tr>
            <tr><th>Form View Rectangle X</th><td>@((ticket != null ? Math.Round(ticket.FormViewRectangleX, 2): ""))</td></tr>
            <tr><th>Form View Rectangle Y</th><td>@((ticket != null ? Math.Round(ticket.FormViewRectangleY, 2) : ""))</td></tr>
            <tr><th>Form View Rectangle Width</th><td>@((ticket != null ? Math.Round(ticket.FormViewRectangleWidth, 2) : ""))</td></tr>
            <tr><th>Form View Rectangle Height</th><td>@((ticket != null ? Math.Round(ticket.FormViewRectangleHeight, 2): ""))</td></tr>
        </table>
        <img src="../NortheastPrecast.webp" />
    </div>
</section>

@code {
    private string? base64Url;
    private int currTicketIndex = 0;
    private ShopTicket? ticket;

    protected override void OnInitialized()
    {
        //plus one because sTService method subtracts one for zero based indexing
        LoadTicket();
    }

    private void GoRight()
    {
        if (currTicketIndex < sTService.Size - 1)
        {
            currTicketIndex++;
            LoadTicket();
        }
    }

    private void GoLeft()
    {
         if (currTicketIndex > 0)
        {
            currTicketIndex--;
            LoadTicket();
        }
    }

    private string GetPDFInfo()
    {
        return sTService.GetTicket(currTicketIndex + 1).ToString().Replace("\n", "<br />");
    }

    private void LoadTicket(){
        ticket = sTService.GetTicket(currTicketIndex + 1);
        if (ticket?.PdfBytes != null && ticket.PdfBytes.Length > 0)
        {
            string pdfBase64 = Convert.ToBase64String(ticket.PdfBytes);
            base64Url = $"data:application/pdf;base64,{pdfBase64}";
        }
    }

    private string? setName(){
        String name = sTService.GetTicket(currTicketIndex + 1).FileName;
        return ticket?.FileName ?? "(no file)";
    }

    private void OnDocumentLoaded(PdfViewerEventArgs args) { }

    private void OnPageChanged(PdfViewerEventArgs args) { }

    private void GoHome(){
        currTicketIndex = 0;
        Navigation.NavigateTo("/");
    }
    private void GoHistory(){
        currTicketIndex = 0;
        Navigation.NavigateTo("/history");
    }
}