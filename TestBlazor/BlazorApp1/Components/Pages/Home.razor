@page "/"
@using BackendLibrary
@using BlazorApp1.Components.Layout
@using Microsoft.AspNetCore.Components.Forms
@using System.Threading.Tasks
@using BlazorBootstrap;
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ShopTicketService sTService

<PageTitle>Home</PageTitle>

<h1>Home</h1>

<section>
	<section>
		<div class="progbar">
			<h1>Progress Bar</h1>
			<div class="progress-container">
				<div class="progress-bar" style="width:@progressValue%"></div>
			</div>
			<p>@progressStatus</p>
		</div>
	</section>

	<div class="pdfcontainer">
		<div class="pdfBox">
			<InputFile OnChange="e => selectedFile = e" accept=".pdf" />
			<p>Loaded PDF: @pdfName</p>
		</div>
	</div>
</section>

<section>
	<div class="btn-container">
		<div class="btn-group" role="group" aria-label="Home actions">
			<button class="@processButtonClass" @onclick="OnPrimary">@buttonLabel</button>
			<button class="historybtn" @onclick="OnSecondary">History</button>
			<ul class = "dropdown-menu @(isDropdownOpen ? "show" : "")">
				<li><a class ="dropdown-item" href = "#">Option 1</a></li>
				<li><a class ="dropdown-item" href = "#">Option 2</a></li>
			</ul>
		</div>
	</div>
</section>

@code {
    private string? pdfName = "No PDF Selected";
    private InputFileChangeEventArgs? selectedFile;
    private int progressValue = 0;
    private string progressStatus = "Select a PDF to process";
    private bool isProcessing = false;
    private bool cancelRequested = false;
    private string buttonLabel = "Process";
    private string processButtonClass => isProcessing ? "cancelbtn" : "processbtn";
    private bool isDropdownOpen = false;

    private async Task OnPrimary()
    {
        if (!isProcessing)
        {
            if (selectedFile != null)
            {
                isProcessing = true;
                cancelRequested = false;
                buttonLabel = "Cancel";
                progressStatus = "Starting PDF processing...";
                StateHasChanged();

                await HandleFileSelected(selectedFile);

                if (!cancelRequested)
                {
                    Navigation.NavigateTo("/processing");
                }
            }
            else
            {
                pdfName = "No file selected";
                StateHasChanged();
            }
        }
        else
        {
            cancelRequested = true;
            progressStatus = "Cancelling...";
            buttonLabel = "Process";
            StateHasChanged();
        }
    }

    private void OnSecondary() => isDropdownOpen = !isDropdownOpen;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            pdfName = "Loading...";
            var file = e.File;
            var totalBytes = file.Size;
            var buffer = new byte[8192];
            long totalRead = 0;

            using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
            using var memoryStream = new MemoryStream();

            int bytesRead;
            while ((bytesRead = await stream.ReadAsync(buffer, 0, buffer.Length)) > 0)
            {
                if (cancelRequested)
                {
                    progressStatus = "Process cancelled.";
                    progressValue = 0;
                    isProcessing = false;
                    buttonLabel = "Process";
                    StateHasChanged();
                    return;
                }

                await memoryStream.WriteAsync(buffer.AsMemory(0, bytesRead));
                totalRead += bytesRead;

                progressValue = (int)((totalRead * 100) / totalBytes);
                progressStatus = $"Reading PDF... {progressValue}%";
                StateHasChanged();

                await Task.Delay(10); 
            }

            byte[] pdfBytes = memoryStream.ToArray();

            sTService.CurrentTicket = new ShopTicket(file.Name, pdfBytes);
            pdfName = sTService.CurrentTicket.FileName;
            progressStatus = "Processing complete.";
            progressValue = 100;

            Console.WriteLine("PDF loaded successfully.");
        }
        catch (Exception ex)
        {
            pdfName = $"Error: {ex.Message}";
            progressStatus = "Error during processing.";
            progressValue = 0;
            Console.WriteLine($"Error uploading file: {ex}");
        }

        isProcessing = false;
        buttonLabel = "Process";
        StateHasChanged();
    }
}