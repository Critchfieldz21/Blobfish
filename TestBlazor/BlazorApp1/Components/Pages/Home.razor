@page "/"
@using BackendLibrary
@using BlazorApp1.Components.Layout
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ShopTicketService sTService



<PageTitle>Home</PageTitle>
<h1>Home</h1>
<section>
<div class="pdfcontainer">
<div class="pdfBox">
	<InputFile OnChange="HandleFileSelected" accept=".pdf" />
	@if (pdfName != null)
	{}
    <p>Loaded PDF: @pdfName</p>
</div>
</div>
</section>

<section>
<div class="btn-container">
	<div class="btn-group" role="group" aria-label="Home actions">
		<button class="processbtn" @onclick="OnPrimary">Process</button>
		<button class="historybtn" @onclick="OnSecondary">History</button>
	</div>
</div>
</section>

@code {
	// Example handlers - replace with real logic as needed
	private string? pdfName = "pdf ";
	private void OnPrimary()
	{
		Console.WriteLine("Primary clicked");
		Navigation.NavigateTo("/counter");
	}

	private void OnSecondary()
	{
		Console.WriteLine("Secondary clicked");
	}

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
		try
		{
			pdfName = "Loading...";
			var file = e.File;

			var uploadsFolder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "uploads");
			Directory.CreateDirectory(uploadsFolder);

			var filePath = Path.Combine(uploadsFolder, file.Name);

			await using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
        	await using (var fileStream = new FileStream(filePath, FileMode.Create, FileAccess.Write, FileShare.None))
        	{
            	await stream.CopyToAsync(fileStream);
        	}

			sTService.CurrentTicket = new ShopTicket(filePath);
			pdfName = sTService.CurrentTicket.ToString();

			Console.WriteLine($"PDF loaded from filepath successfully");
		}
		catch (Exception ex)
		{
			pdfName = $"Error: {ex.Message}";
			Console.WriteLine($"Error uploading file: {ex}");
		}
		StateHasChanged();
    }

}
}