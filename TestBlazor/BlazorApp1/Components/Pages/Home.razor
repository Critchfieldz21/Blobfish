@page "/"
@using BackendLibrary
@using BlazorApp1.Components.Layout
@using Microsoft.AspNetCore.Components.Forms
@using System.Threading.Tasks
@using BlazorBootstrap;
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ShopTicketService sTService

<PageTitle>Home</PageTitle>

<h1>Home</h1>

<section>
    <div class="pdfcontainer">
        <div class="pdfBox">
            <InputFile OnChange="e => selectedFiles = e" multiple accept=".pdf" />
            <p>Loaded PDF: @pdfName</p>
        </div>

        <div class="loading-container">
            @if (isProcessing)
            {
                <img src="../Northeast.png" class="spinner" alt="Loading..." />
                <p>@loadingMessage</p>

                @if (totalFiles > 0)
                {
                    <p>Completed @completedCount / @totalFiles</p>
                }
            }
        </div>
    </div>
</section>

<section>
    <div class="btn-container">
        <div class="btn-group" role="group" aria-label="Home actions">
            <button class="@processButtonClass" @onclick="OnPrimary">@buttonLabel</button>
            <button class="historybtn" @onclick="GoToHistory">History</button>

            <ul class="dropdown-menu @(isDropdownOpen ? "show" : "")">
                <li><a class="dropdown-item" href="#">Option 1</a></li>
                <li><a class="dropdown-item" href="#">Option 2</a></li>
            </ul>
        </div>
    </div>
</section>

<Modal @ref="modalError" Title="Processing Error">
    <BodyTemplate>
        @((MarkupString)modalErrorMessage)
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Close</Button>
    </FooterTemplate>
</Modal>

@code {
    private string? pdfName = "No PDF Selected";
    private string loadingMessage = "";
    private int totalFiles = 0;
    private int completedCount = 0;
    private InputFileChangeEventArgs? selectedFiles;
    private bool isProcessing = false;
    private bool cancelRequested = false;
    private string buttonLabel = "Process";
    private string processButtonClass => isProcessing ? "cancelbtn" : "processbtn";
    private bool isDropdownOpen = false;
    private Modal? modalError;
    private string modalErrorMessage = "An error occurred during PDF processing.";

    private List<ShopTicket> tempList = new List<ShopTicket>();

    private void GoToHistory()
    {
        Navigation.NavigateTo("/history");
    }

    private async Task OnPrimary()
    {
        if (sTService.Size > 0)
        {
            sTService.ClearCurrentTickets();
        }

        if (!isProcessing)
        {
            if (selectedFiles != null)
            {
                isProcessing = true;
                cancelRequested = false;
                completedCount = 0;
                buttonLabel = "Cancel";

                try
                {
                    totalFiles = selectedFiles.GetMultipleFiles(50).Count;

                    loadingMessage = totalFiles > 1
                    ? $"Processing batch of {totalFiles} PDFs..."
                    : "Processing PDF...";

                    StateHasChanged();
                    await HandleFileSelected(selectedFiles);
                }
                catch (Exception ex)
                {
                    cancelRequested = true;
                    modalErrorMessage = ex.Message;
                    if (ex.InnerException is ExtractionException)
                    {
                        modalErrorMessage += "<br /><br />Suggestion: Double-check if this file is a valid shop ticket PDF";
                    }
                    await (modalError?.ShowAsync() ?? Task.CompletedTask);

                    pdfName = "Error";
                    isProcessing = false;
                    buttonLabel = "Process";
                    loadingMessage = "";
                    completedCount = 0;
                    totalFiles = 0;
                    StateHasChanged();
                }

                if (!cancelRequested)
                {
                    sTService.SetCurrentTicket(tempList);
                    Navigation.NavigateTo("/processing");
                }
            }
            else
            {
                pdfName = "No file selected";
                StateHasChanged();
            }
        }
        else
        {
            cancelRequested = true;
            isProcessing = false;
            buttonLabel = "Process";
            StateHasChanged();
        }
    }

    private void OnSecondary() => isDropdownOpen = !isDropdownOpen;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(50);
        if (files.Count == 0) return;

        foreach (var file in files)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
            using var memoryStream = new MemoryStream();
            var buffer = new byte[8192];

            int bytesRead;
            while ((bytesRead = await stream.ReadAsync(buffer, 0, buffer.Length)) > 0)
            {
                if (cancelRequested)
                {
                    isProcessing = false;
                    buttonLabel = "Process";
                    sTService.ClearCurrentTickets();
                    pdfName = "Process cancelled.";
                    completedCount = 0;
                    totalFiles = 0;
                    StateHasChanged();
                    return;
                }

                await memoryStream.WriteAsync(buffer.AsMemory(0, bytesRead));
            }

            byte[] pdfBytes = memoryStream.ToArray();
            tempList.Add(new ShopTicket(file.Name, pdfBytes, "Services/best.onnx"));

            completedCount++;
            pdfName = file.Name; // shows the last processed file
            StateHasChanged();
        }

        // Finished batch or single PDF
        isProcessing = false;
        buttonLabel = "Process";
        pdfName = totalFiles > 1
        ? "Batch processing complete."
        : $"Processed: {files[0].Name}";
        loadingMessage = "";
        completedCount = 0;
        totalFiles = 0;
        StateHasChanged();
    }

    private async Task OnHideModalClick()
    {
        await (modalError?.HideAsync() ?? Task.CompletedTask);
    }
}