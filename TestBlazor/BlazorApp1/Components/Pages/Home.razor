@page "/"
@using BlazorApp1.Components.Layout
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@using BackendLibrary

<PageTitle>Home</PageTitle>
<h1>Home</h1>

<div class="d-flex justify-content-center align-items-center" style="height:20vh;">
	<InputFile OnChange="HandleFileSelected" accept=".pdf" />
	@if (pdfName != null)
	{
    <p>Loaded PDF: @pdfName</p>
	}
</div>
<div class="d-flex justify-content-center align-items-center" style="height:60vh;">
	<div class="btn-group" role="group" aria-label="Home actions">
		<NavLink class="btn btn-primary" href="counter">Primary action</NavLink>
		<button class="btn btn-secondary" @onclick="OnSecondary">Secondary action</button>
	</div>
</div>

@code {
	// Example handlers - replace with real logic as needed
	private string? pdfName;
	private void OnPrimary()
	{
		Console.WriteLine("Primary clicked");
		Navigation.NavigateTo("/counter");
	}

	private void OnSecondary()
	{
		Console.WriteLine("Secondary clicked");
	}

	private IBrowserFile? uploadedFile;

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
	{
		uploadedFile = e.File;

		using var stream = uploadedFile.OpenReadStream(maxAllowedSize: 10_000_000); // 10MB
		using var memoryStream = new MemoryStream();
		await stream.CopyToAsync(memoryStream);

		byte[]? pdfBytes = memoryStream.ToArray();

		// Pass to your service or helper class
		// ShopTicket shopTicket = new ShopTicket();
		// PDFDocument pdf = shopTicket.LoadPdf(pdfBytes);
	}
	}

}
