@page "/"
@using BackendLibrary
@using BlazorApp1.Components.Layout
@using Microsoft.AspNetCore.Components.Forms
@using System.Threading.Tasks
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ShopTicketService sTService

<PageTitle>Home</PageTitle>
<h1>Home</h1>
<section>
<section>
<div class = "progbar">
<h1>Progress Bar</h1>
</div>
</section>
<div class="pdfcontainer">
<div class="pdfBox">
	<InputFile OnChange="e => selectedFile = e" accept=".pdf" />
	@if (pdfName != null)
	{}
    <p>Loaded PDF: @pdfName</p>
</div>
</div>
</section>

<section>
<div class="btn-container">
	<div class="btn-group" role="group" aria-label="Home actions">
		<button class="processbtn" @onclick="OnPrimary">Process</button>
		<button class="historybtn" @onclick="OnSecondary">History</button>
	</div>
</div>
</section>

@code {
    // Example handlers - replace with real logic as needed
    private string? pdfName = "pdf ";
    private InputFileChangeEventArgs? selectedFile;
	private async Task OnPrimary()
	{
		Console.WriteLine("Primary clicked");
		if (selectedFile != null)
		{
			await HandleFileSelected(selectedFile);
			Navigation.NavigateTo("/processing");
		}
		else
		{
			pdfName = "No file selected";
			StateHasChanged();
		}
	}

	private void OnSecondary()
	{
		Console.WriteLine("Secondary clicked");
	}

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
		try
		{
			pdfName = "Loading...";
			var file = e.File;

			using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
    		using var memoryStream = new MemoryStream();
    		await stream.CopyToAsync(memoryStream);
    		byte[] pdfBytes = memoryStream.ToArray();

			sTService.CurrentTicket = new ShopTicket(file.Name, pdfBytes);
			pdfName = sTService.CurrentTicket.ToString();

			Console.WriteLine($"PDF loaded from filepath successfully: {pdfName}");
		}
		catch (Exception ex)
		{
			pdfName = $"Error: {ex.Message}";
			Console.WriteLine($"Error uploading file: {ex}");
		}
		StateHasChanged();
    }

}
}