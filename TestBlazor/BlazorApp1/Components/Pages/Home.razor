	private void OnSecondary() => isDropdownOpen = !isDropdownOpen;

	

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
{
    try
    {
        pdfName = "Loading...";
        var file = e.File;
        var totalBytes = file.Size;
        var buffer = new byte[8192];
        long totalRead = 0;

        using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
        using var memoryStream = new MemoryStream();

        int bytesRead;
        while ((bytesRead = await stream.ReadAsync(buffer, 0, buffer.Length)) > 0)
        {
            if (cancelRequested)
            {
                progressStatus = "Process cancelled.";
                progressValue = 0;
                isProcessing = false;
                buttonLabel = "Process";
                StateHasChanged();
                return;
            }

            await memoryStream.WriteAsync(buffer.AsMemory(0, bytesRead));
            totalRead += bytesRead;

            
            progressValue = (int)((totalRead * 100) / totalBytes);
            progressStatus = $"Reading PDF... {progressValue}%";
            StateHasChanged();

            await Task.Delay(10);
        }

        byte[] pdfBytes = memoryStream.ToArray();

        sTService.CurrentTicket = new ShopTicket(file.Name, pdfBytes);
        pdfName = sTService.CurrentTicket.FileName;
        progressStatus = "Processing complete.";
        progressValue = 100;

        Console.WriteLine("PDF loaded successfully.");
    }
    catch (Exception ex)
    {
        pdfName = $"Error: {ex.Message}";
        progressStatus = "Error during processing.";
        progressValue = 0;
        Console.WriteLine($"Error uploading file: {ex}");
    }

    isProcessing = false;
    buttonLabel = "Process";
    StateHasChanged();
}


	private async Task SimulateProgressBarAsync()
	{
		progressValue = 0;
		StateHasChanged();

		while (progressValue < 100 && !cancelRequested)
		{
			progressValue += 5;
			progressStatus = $"Processing... {progressValue}%";
			StateHasChanged();
			await Task.Delay(150);
		}

		if (cancelRequested)
		{
			progressStatus = "Process Cancelled.";
			progressValue = 0;
		}
		else
		{
			progressStatus = "Done!";
		}

		isProcessing = false;
		buttonLabel = "Process";
		StateHasChanged();
	}
}